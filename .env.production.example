# ═══════════════════════════════════════════════════════════════════
# PRODUCTION ENVIRONMENT VARIABLES
# Copy this file to .env.production and fill in all values.
# Then set these in Render / Vercel dashboards.
# ═══════════════════════════════════════════════════════════════════

# ── Shared JWT Signing Secret ─────────────────────────────────────
JWT_SECRET=change-me-to-a-64-char-random-string

# ── Battery API (Render) ───────────────────────────────────────────
PORT=8080
DATABASE_URL=postgresql://postgres.[battery-ref]:[password]@aws-1-ap-south-1.pooler.supabase.com:5432/postgres
BASE_URL=https://battery-api-xxx.onrender.com
JWT_SECRET=${JWT_SECRET}
JWT_EXPIRY=15m
REFRESH_EXPIRY=168h

# Payments (Razorpay)
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxx

# Email (Resend)
RESEND_API_KEY=re_xxxxxxxx
EMAIL_FROM=noreply@yourdomain.com
EMAIL_FROM_NAME=ExportReady

# AI Configuration
GROQ_API_KEY=gsk_xxxxxxxx
GEMINI_API_KEY=AIzaSyxxxxxxxx
AI_PROVIDERS=groq,gemini

# Supabase (Object Storage)
SUPABASE_URL=https://[battery-ref].supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Redis (Upstash)
UPSTASH_REDIS_REST_URL=https://[your-redis].upstash.io
UPSTASH_REDIS_REST_TOKEN=[token]

# ── Battery Web (Vercel) ───────────────────────────────────────────
NEXT_PUBLIC_API_URL=https://battery-api-xxx.onrender.com/api/v1
NEXT_PUBLIC_SUPABASE_URL=https://[battery-ref].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=[battery-anon-key]
NEXT_PUBLIC_BRAND_NAME=ExportReady
JWT_SECRET=${JWT_SECRET}
