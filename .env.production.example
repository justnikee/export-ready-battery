# ═══════════════════════════════════════════════════════════════════
# PRODUCTION ENVIRONMENT VARIABLES
# Copy this file to .env.production and fill in all values.
# Then set these in Render / Vercel dashboards.
#
# Architecture: 3 Supabase projects (platform, battery, textile)
#               3 Render services (platform-core, battery-api, textile-api)
#               4 Vercel projects (marketing, battery-web, textile-web, admin)
# ═══════════════════════════════════════════════════════════════════

# ── Shared Secrets ─────────────────────────────────────────────────
# All services must use the SAME JWT_SECRET for cross-service auth
JWT_SECRET=change-me-to-a-64-char-random-string

# ── Platform Core (Render) ─────────────────────────────────────────
# Uses its OWN Supabase project (isolated from battery/textile data)
PLATFORM_CORE_PORT=8081
PLATFORM_CORE_DATABASE_URL=postgresql://postgres.[platform-ref]:[password]@aws-1-ap-south-1.pooler.supabase.com:5432/postgres
PLATFORM_CORE_BASE_URL=https://platform-core-xxx.onrender.com
PLATFORM_CORE_JWT_SECRET=${JWT_SECRET}
PLATFORM_CORE_JWT_EXPIRY=15m
PLATFORM_CORE_REFRESH_EXPIRY=168h

# Payments (Razorpay)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxx

# Email (Resend)
RESEND_API_KEY=re_xxxxxxxx
EMAIL_FROM=noreply@yourdomain.com
EMAIL_FROM_NAME=ExportReady

# ── Battery API (Render) ───────────────────────────────────────────
# Uses its OWN Supabase project
BATTERY_API_PORT=8080
BATTERY_API_DATABASE_URL=postgresql://postgres.[battery-ref]:[password]@aws-1-ap-south-1.pooler.supabase.com:5432/postgres
BATTERY_API_BASE_URL=https://battery-api-xxx.onrender.com
BATTERY_API_JWT_SECRET=${JWT_SECRET}

# Supabase (Battery project)
BATTERY_SUPABASE_URL=https://[battery-ref].supabase.co
BATTERY_SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Redis (Upstash)
BATTERY_UPSTASH_REDIS_REST_URL=https://[your-redis].upstash.io
BATTERY_UPSTASH_REDIS_REST_TOKEN=[token]

# ── Textile API (Render) ───────────────────────────────────────────
# Uses its OWN Supabase project
TEXTILE_API_PORT=8082
TEXTILE_API_DATABASE_URL=postgresql://postgres.[textile-ref]:[password]@aws-1-ap-south-1.pooler.supabase.com:5432/postgres
TEXTILE_API_BASE_URL=https://textile-api-xxx.onrender.com
TEXTILE_API_JWT_SECRET=${JWT_SECRET}

# Supabase (Textile project)
TEXTILE_SUPABASE_URL=https://[textile-ref].supabase.co
TEXTILE_SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── Marketing Web (Vercel) ─────────────────────────────────────────
NEXT_PUBLIC_BATTERY_API_URL=${BATTERY_API_BASE_URL}
NEXT_PUBLIC_TEXTILE_API_URL=${TEXTILE_API_BASE_URL}
NEXT_PUBLIC_PLATFORM_CORE_URL=${PLATFORM_CORE_BASE_URL}

# ── Battery Web (Vercel) ───────────────────────────────────────────
NEXT_PUBLIC_BATTERY_API_URL=${BATTERY_API_BASE_URL}
NEXT_PUBLIC_PLATFORM_CORE_URL=${PLATFORM_CORE_BASE_URL}
NEXT_PUBLIC_SUPABASE_URL=${BATTERY_SUPABASE_URL}
NEXT_PUBLIC_SUPABASE_ANON_KEY=[battery-anon-key]

# ── Textile Web (Vercel) ───────────────────────────────────────────
NEXT_PUBLIC_TEXTILE_API_URL=${TEXTILE_API_BASE_URL}
NEXT_PUBLIC_PLATFORM_CORE_URL=${PLATFORM_CORE_BASE_URL}
NEXT_PUBLIC_SUPABASE_URL=${TEXTILE_SUPABASE_URL}
NEXT_PUBLIC_SUPABASE_ANON_KEY=[textile-anon-key]

# ── Admin Web (Vercel) ─────────────────────────────────────────────
# Internal dashboard — connects to platform-core + all APIs for stats
NEXT_PUBLIC_PLATFORM_CORE_URL=${PLATFORM_CORE_BASE_URL}
NEXT_PUBLIC_BATTERY_API_URL=${BATTERY_API_BASE_URL}
NEXT_PUBLIC_TEXTILE_API_URL=${TEXTILE_API_BASE_URL}
ADMIN_API_KEY=admin-secret-key-for-internal-api-access
