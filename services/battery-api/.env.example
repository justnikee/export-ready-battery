# Server Configuration
PORT=8080

# Database Connection
DATABASE_URL=postgres://postgres:postgres@localhost:5432/anvayalabs?sslmode=disable

# HTTP request body hard ceiling is 10 MiB (limits.MaxRequestBodyBytes) — not env-configurable.
# CSV/multipart uploads must not claim a higher max than this (P-06).

# pgx pool sizing for THIS process (HTTP handlers + in-process workers share one pool).
# Defaults: MaxConns=20, MinConns=2 (was 4/1 — too small under concurrent dashboards + jobs).
# Pooler math: (number of battery-api instances) × DB_MAX_CONNS  ≤  Supabase/PgBouncer max clients.
# Free/pro poolers are often 15–60 total — lower DB_MAX_CONNS if you run multiple replicas.
# DB_MAX_CONNS=20
# DB_MIN_CONNS=2
# DB_MAX_CONN_LIFETIME_MIN=60
# DB_MAX_CONN_IDLE_MIN=30

# Base URL for QR Code links (your Next.js frontend)
BASE_URL=http://localhost:3000

# JWT Configuration
JWT_SECRET=your-super-secret-key-at-least-32-characters
JWT_EXPIRY=15m
REFRESH_EXPIRY=168h

# Platform admin key for cross-tenant operator endpoints (document verification,
# regulator key management). Sent as header X-Admin-API-Key. Fail-closed when empty.
# Generate with: openssl rand -hex 32
# NEVER expose this as NEXT_PUBLIC_* in any frontend.
ADMIN_API_KEY=

# Optional Art. 78 regulator bootstrap key (header X-Regulator-Key).
# GLOBAL scope when set — prefer DB-scoped keys via:
#   POST /api/v1/admin/regulator-keys  (X-Admin-API-Key)
# Leave empty in production once scoped keys are issued.
# REGULATOR_API_KEY=

# Trust reverse-proxy client IP headers (X-Forwarded-For / X-Real-IP) for rate limits.
# - true/false force on/off
# - unset: defaults to true when APP_ENV is production or staging, else false
# When trusted, the *rightmost* X-Forwarded-For hop is used (not client-spoofable leftmost).
# TRUST_PROXY=true


# VC Signing Key (Ed25519 private key, base64-encoded — 32-byte seed or 64-byte key).
# Required in production. If unset outside production, a fixed insecure dev-only key is used.
# Generate one with: openssl rand -base64 32
VC_SIGNING_KEY=

# Registry Integration
BIS_BASE_URL=https://www.bis.gov.in
CPCB_BASE_URL=https://eprbatterycpcb.in
EU_NANDO_BASE_URL=https://webgate.ec.europa.eu/single-market-compliance-space/notified-bodies
UN38_BASE_URL=
REGISTRY_HTTP_TIMEOUT=15s
REGISTRY_WORKER_COUNT=3
REGISTRY_WORKER_INTERVAL=30s
REGISTRY_ASYNC_ENABLED=true

# LLM Gateway / AI Core Configuration
AI_PROVIDERS=groq,gemini
GROQ_API_KEY=
GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
AI_REQUEST_TIMEOUT=30s
AI_CIRCUIT_BREAKER_THRESHOLD=5
AI_CIRCUIT_BREAKER_COOLDOWN=60s
AI_GROQ_DAILY_LIMIT=500
AI_GEMINI_DAILY_LIMIT=1000
