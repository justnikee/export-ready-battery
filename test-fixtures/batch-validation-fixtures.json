{
  "_comment": "Shared validation-rule fixtures for CreateBatch (draft-friendly). HSN format is checked only when provided; DVA/BoE/IEC/customs completeness is an activation gate, not create. PLI claim and AUDITED mode still fail create if incomplete. Consumed by batch_creation_validator_test.go and batch-form-schema.test.ts.",
  "cases": [
    {
      "name": "HSN code missing the 8507 battery prefix",
      "rule": "hsn-prefix",
      "marketRegion": "INDIA",
      "cellSource": "DOMESTIC",
      "hsnCode": "12345678",
      "salePrice": 1000,
      "cellCostDomestic": 600,
      "cellCostImported": 400,
      "expectValid": false,
      "expectErrors": [{ "go": "hsn_code", "ts": "hsnCode" }]
    },
    {
      "name": "HSN omitted at create is allowed",
      "rule": "hsn-prefix",
      "marketRegion": "INDIA",
      "cellSource": "DOMESTIC",
      "hsnCode": "",
      "expectValid": true
    },
    {
      "name": "HSN code with valid 8507 battery prefix",
      "rule": "hsn-prefix",
      "marketRegion": "INDIA",
      "cellSource": "DOMESTIC",
      "hsnCode": "85076000",
      "salePrice": 1000,
      "cellCostDomestic": 600,
      "cellCostImported": 400,
      "expectValid": true
    },
    {
      "name": "HSN code with the right prefix but the wrong length",
      "rule": "hsn-length",
      "marketRegion": "INDIA",
      "cellSource": "DOMESTIC",
      "hsnCode": "850760",
      "salePrice": 1000,
      "cellCostDomestic": 600,
      "cellCostImported": 400,
      "expectValid": false,
      "expectErrors": [{ "go": "hsn_code", "ts": "hsnCode" }]
    },
    {
      "name": "Domestic batch with zero Domestic Value Add",
      "rule": "dva-positive",
      "marketRegion": "INDIA",
      "cellSource": "DOMESTIC",
      "hsnCode": "85076000",
      "salePrice": 100,
      "cellCostDomestic": 0,
      "cellCostImported": 100,
      "expectValid": true
    },
    {
      "name": "PLI claimed below the 50% DVA threshold",
      "rule": "pli-threshold",
      "marketRegion": "INDIA",
      "cellSource": "DOMESTIC",
      "hsnCode": "85076000",
      "salePrice": 100,
      "cellCostDomestic": 40,
      "cellCostImported": 60,
      "pliCompliant": true,
      "expectValid": false,
      "expectErrors": [{ "go": "pli_compliant", "ts": "pliCompliant" }]
    },
    {
      "name": "PLI claimed at exactly the 50% DVA threshold (boundary — should pass)",
      "rule": "pli-threshold",
      "marketRegion": "INDIA",
      "cellSource": "DOMESTIC",
      "hsnCode": "85076000",
      "salePrice": 100,
      "cellCostDomestic": 50,
      "cellCostImported": 50,
      "pliCompliant": true,
      "expectValid": true
    },
    {
      "name": "Imported cells missing Bill of Entry No.",
      "rule": "imported-required-fields",
      "marketRegion": "INDIA",
      "cellSource": "IMPORTED",
      "hsnCode": "85076000",
      "dvaSource": "ESTIMATED",
      "billOfEntryNo": "",
      "cellCountryOfOrigin": "CN",
      "customsDate": "2024-03-01",
      "expectValid": true
    },
    {
      "name": "Imported cells missing country of origin",
      "rule": "imported-required-fields",
      "marketRegion": "INDIA",
      "cellSource": "IMPORTED",
      "hsnCode": "85076000",
      "dvaSource": "ESTIMATED",
      "billOfEntryNo": "BOE123",
      "cellCountryOfOrigin": "",
      "customsDate": "2024-03-01",
      "expectValid": true
    },
    {
      "name": "Imported cells missing the customs/import date",
      "rule": "imported-required-fields",
      "marketRegion": "INDIA",
      "cellSource": "IMPORTED",
      "hsnCode": "85076000",
      "dvaSource": "ESTIMATED",
      "billOfEntryNo": "BOE123",
      "cellCountryOfOrigin": "CN",
      "customsDate": "",
      "expectValid": true
    },
    {
      "name": "Audited DVA mode missing the audited percentage",
      "rule": "audited-required-fields",
      "marketRegion": "INDIA",
      "cellSource": "DOMESTIC",
      "hsnCode": "85076000",
      "dvaSource": "AUDITED",
      "auditedDva": null,
      "uploadedFileUrl": "https://example.com/ca-cert.pdf",
      "expectValid": false,
      "expectErrors": [{ "go": "audited_domestic_value_add", "ts": "auditedDva" }]
    },
    {
      "name": "Audited DVA mode missing the CA certificate upload",
      "rule": "audited-required-fields",
      "marketRegion": "INDIA",
      "cellSource": "DOMESTIC",
      "hsnCode": "85076000",
      "dvaSource": "AUDITED",
      "auditedDva": 65,
      "uploadedFileUrl": null,
      "expectValid": false,
      "expectErrors": [{ "go": "pli_certificate_url", "ts": "uploadedFileUrl" }]
    },
    {
      "name": "Audited DVA percentage out of the valid 0-100 range",
      "rule": "audited-range",
      "marketRegion": "INDIA",
      "cellSource": "DOMESTIC",
      "hsnCode": "85076000",
      "dvaSource": "AUDITED",
      "auditedDva": 150,
      "uploadedFileUrl": "https://example.com/ca-cert.pdf",
      "expectValid": false,
      "expectErrors": [{ "go": "audited_domestic_value_add", "ts": "auditedDva" }]
    },
    {
      "name": "EU batch missing the required battery category",
      "rule": "eu-battery-category",
      "marketRegion": "EU",
      "batteryCategory": "",
      "expectValid": false,
      "expectErrors": [{ "go": "battery_category", "ts": "batteryCategory" }]
    },
    {
      "name": "Manufacturing end date before start date",
      "rule": "date-ordering",
      "marketRegion": "INDIA",
      "cellSource": "DOMESTIC",
      "hsnCode": "85076000",
      "salePrice": 1000,
      "cellCostDomestic": 600,
      "cellCostImported": 400,
      "manufacturingStartDate": "2024-06-15",
      "manufacturingEndDate": "2024-06-10",
      "expectValid": false,
      "expectErrors": [{ "go": "manufacturing_end_date", "ts": "manufacturingEndDate" }]
    }
  ]
}
