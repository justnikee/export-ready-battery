# Anvaya Labs — Monorepo Environment Variables
# Copy to .env and fill in real values. DO NOT commit .env.
#
# Infra: Supabase (PostgreSQL + Storage), Upstash (Redis)

# ---------------------------------------------------------------------------
# Platform Core (Auth, Billing, Teams) — Port 8081
# ---------------------------------------------------------------------------
PLATFORM_CORE_PORT=8081
PLATFORM_CORE_DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
PLATFORM_CORE_JWT_SECRET=change-me-in-production-min-32-chars
PLATFORM_CORE_BASE_URL=http://localhost:3000

# Razorpay (billing payments)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=noreply@example.com
EMAIL_FROM_NAME=Anvaya Labs

# OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Battery API — Port 8080
# ---------------------------------------------------------------------------
BATTERY_API_PORT=8080
BATTERY_API_DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
BATTERY_API_JWT_SECRET=change-me-in-production-min-32-chars
BATTERY_API_BASE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Textile API — Port 8082
# ---------------------------------------------------------------------------
TEXTILE_API_PORT=8082
TEXTILE_API_DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
TEXTILE_API_JWT_SECRET=change-me-in-production-min-32-chars
TEXTILE_API_BASE_URL=http://localhost:3001

# ---------------------------------------------------------------------------
# Supabase (shared across services)
# ---------------------------------------------------------------------------
SUPABASE_URL=https://[PROJECT_REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Upstash Redis (optional — for rate limiting, caching)
# ---------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---------------------------------------------------------------------------
# Frontends
# ---------------------------------------------------------------------------
NEXT_PUBLIC_PLATFORM_CORE_URL=http://localhost:8081
NEXT_PUBLIC_BATTERY_API_URL=http://localhost:8080
NEXT_PUBLIC_TEXTILE_API_URL=http://localhost:8082
# Battery web frontend reads this (maps to battery API base + /api/v1)
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
