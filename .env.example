# ExportReady — Monorepo Environment Variables
# Copy to .env and fill in real values. DO NOT commit .env.

# ---------------------------------------------------------------------------
# Battery API — Port 8080
# ---------------------------------------------------------------------------
PORT=8080
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
JWT_SECRET=change-me-in-production-min-64-chars
BASE_URL=http://localhost:3000

# Razorpay (billing payments)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=noreply@example.com
EMAIL_FROM_NAME=ExportReady

# OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AI Providers (Groq & Gemini for regulatory validation)
GROQ_API_KEY=
GEMINI_API_KEY=
AI_PROVIDERS=groq,gemini

# ---------------------------------------------------------------------------
# Supabase (Object Storage for uploads)
# ---------------------------------------------------------------------------
SUPABASE_URL=https://[PROJECT_REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Upstash Redis (optional — for rate limiting, caching)
# ---------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---------------------------------------------------------------------------
# Frontend (battery-web)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_BRAND_NAME=ExportReady
NEXT_PUBLIC_SUPABASE_URL=https://[PROJECT_REF].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
